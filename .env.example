# Copia a .env.local para desarrollo. En Railway van como variables del servicio.

# Postgres. En Railway lo da el plugin como DATABASE_URL.
DATABASE_URL=postgres://usuario@localhost:5432/cobros

# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Genera el valor con: npm run hash-passphrase
APP_PASSPHRASE_HASH=

# Días que dura la sesión antes de volver a pedir la passphrase.
SESSION_DAYS=30

# --- Web Push ---
# Genera el par con: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Zona horaria del usuario: "las 9am" son las 9am de quien cobra,
# aunque el servidor corra en UTC.
APP_TIMEZONE=America/Mexico_City

# Cada cuántos minutos revisa si toca mandar avisos.
REMINDER_INTERVAL_MINUTES=1
